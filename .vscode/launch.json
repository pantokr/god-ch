{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "웹 (로그인 유지)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=5000",
        "--web-browser-flag=--user-data-dir=${workspaceFolder}/.chrome-profile"
      ]
    },
    {
      "name": "웹 서버 (내 Chrome에서 열기)",
      "request": "launch",
      "type": "dart",
      "deviceId": "web-server",
      "args": ["--web-port=5000"]
    }
  ]
}
