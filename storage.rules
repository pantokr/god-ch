rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 교인 정보는 Firestore에 있으므로 교차 서비스 조회로 확인한다.
    function memberDoc(cid) {
      return /databases/(default)/documents/churches/$(cid)/members/$(request.auth.uid);
    }
    function isActive(cid) {
      return request.auth != null
        && firestore.exists(memberDoc(cid))
        && firestore.get(memberDoc(cid)).data.status == 'approved';
    }
    function isAdmin(cid) {
      return isActive(cid) && firestore.get(memberDoc(cid)).data.role == 'admin';
    }

    // 앱 운영자: 계정에 platformAdmin 클레임이 있거나 admins/{uid} 문서가 있는 계정.
    function isPlatformAdmin() {
      return request.auth != null
        && (request.auth.token.get('platformAdmin', false) == true
            || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }
    function isImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 성경 본문: bible/verse.csv. 로그인한 회원이 읽고 앱 운영자만 올린다 (말씀 묵상에서 구절을 가져올 때 쓴다).
    match /bible/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isPlatformAdmin()
        && request.resource.size < 60 * 1024 * 1024
        && fileName == 'verse.csv';
      allow delete: if isPlatformAdmin();
    }

    // 교회 썸네일: churches/{교회}/thumbnail/{파일}. 로그인한 회원이 볼 수 있고 앱 운영자만 올리고 지운다.
    match /churches/{churchId}/thumbnail/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isPlatformAdmin() && isImage();
      allow delete: if isPlatformAdmin();
    }

    // 회원 프로필 사진: users/{uid}/avatar/{파일}. 로그인한 회원이 볼 수 있고 본인과 앱 운영자가 올리고 지운다.
    match /users/{userId}/avatar/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if (request.auth.uid == userId || isPlatformAdmin()) && isImage();
      allow delete: if request.auth.uid == userId || isPlatformAdmin();
    }

    // 교회 메인 페이지 이미지: churches/{교회}/{종류}/{파일}
    // 승인된 교인이 읽고, 교회 운영자만 올리고 지운다. 이미지 10MB 이하만.
    // 종류 목록은 firestore.rules의 콘텐츠 컬렉션과 같아야 한다.
    match /churches/{churchId}/{kind}/{fileName} {
      allow read: if isActive(churchId);
      allow create, update: if isAdmin(churchId)
        && kind in ['notices', 'events', 'photos', 'sermons', 'devotions']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin(churchId);
    }
  }
}
