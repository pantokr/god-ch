rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function memberPath(cid) {
      return /databases/$(database)/documents/churches/$(cid)/members/$(request.auth.uid);
    }
    // 교회별로 승인된 교인만 해당 교회 데이터(기도제목 등)에 접근할 수 있다.
    // 앱 운영자는 교회 소속이 아니므로 기도제목 내용은 볼 수 없다 (아래 isManager/isOwner 참고).
    function isActive(cid) {
      return signedIn() && exists(memberPath(cid)) && get(memberPath(cid)).data.status == 'approved';
    }
    function isStaff(cid) {
      return isActive(cid) && get(memberPath(cid)).data.role in ['staff', 'admin'];
    }
    function isAdmin(cid) {
      return isActive(cid) && get(memberPath(cid)).data.role == 'admin';
    }
    // 교회 관리 데이터(교인·초대 코드·부서)를 다룰 수 있는 사람: 그 교회의 교역자·교회 운영자, 앱 운영자.
    function isManager(cid) {
      return isPlatformAdmin() || isStaff(cid);
    }
    // 교인의 역할을 바꿀 수 있는 사람: 그 교회의 교회 운영자, 앱 운영자.
    function isOwner(cid) {
      return isPlatformAdmin() || isAdmin(cid);
    }
    function prayer(cid, pid) {
      return get(/databases/$(database)/documents/churches/$(cid)/prayers/$(pid)).data;
    }
    // 부서 전용 글(departmentId != null)은 그 부서에 소속된 교인에게만 보인다.
    function inDept(cid, deptId) {
      return deptId == null || deptId in get(memberPath(cid)).data.departmentIds;
    }
    function isOpen(cid, pid) {
      return prayer(cid, pid).visibility == 'public'
        && prayer(cid, pid).deleted == false
        && inDept(cid, prayer(cid, pid).departmentId);
    }
    function inviteOk(cid, code) {
      let invite = get(/databases/$(database)/documents/inviteCodes/$(code)).data;
      return invite.churchId == cid && invite.expiresAt > request.time;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // 앱 운영자: 계정에 platformAdmin 클레임이 있거나 admins/{uid} 문서가 있는 계정.
    // 둘 다 서버 관리자 권한으로만 만들 수 있다.
    function isPlatformAdmin() {
      return signedIn()
        && (request.auth.token.get('platformAdmin', false) == true
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // 이메일 인증을 마친 계정인가 (Google 로그인은 항상 인증됨).
    function emailVerified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }
    // 교회 생성 요청 문서. 승인되면 같은 ID로 교회가 만들어진다.
    function churchRequest(requestId) {
      return get(/databases/$(database)/documents/churchRequests/$(requestId)).data;
    }

    // 로그인 ID → 이메일 조회. 로그인 전에 읽어야 하므로 get은 누구나 가능하고 목록은 볼 수 없다.
    // ID는 한 번 만들면 바꾸거나 지울 수 없고, 예약된 ID(admin 등)는 만들 수 없다.
    match /loginIds/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && loginId.matches('^[a-z][a-z0-9_]{3,19}$')
        && !(loginId in ['admin', 'administrator', 'root', 'system', 'operator'])
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // 회원 프로필: 가입할 때 받은 이름·전화번호와 개인정보 제3자 제공 동의 기록.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isPlatformAdmin());
      // 앱 운영자 패널의 회원 관리에서 전체 회원을 볼 수 있다.
      allow list: if isPlatformAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['loginId', 'name', 'phone', 'email', 'consentThirdParty', 'consentAt', 'createdAt'])
        && request.resource.data.consentThirdParty == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      // 자신이 운영자인지 확인할 수 있을 뿐, 클라이언트에서는 만들거나 바꿀 수 없다.
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // 교회 생성 요청: 누구나 신청하고, 앱 운영자가 승인/거절한다.
    match /churchRequests/{requestId} {
      allow create: if emailVerified()
        && request.resource.data.keys().hasOnly(
             ['requesterId', 'requesterName', 'requesterEmail', 'requesterPhone', 'name', 'phone',
              'address', 'status', 'createdAt'])
        && (!('requesterPhone' in request.resource.data) || request.resource.data.requesterPhone.size() <= 20)
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 30;
      // 요청자는 자기 요청만, 운영자는 모든 요청을 읽는다.
      allow get: if signedIn() && (resource.data.requesterId == request.auth.uid || isPlatformAdmin());
      allow list: if signedIn() && (resource.data.requesterId == request.auth.uid || isPlatformAdmin());
      allow update: if isPlatformAdmin()
        && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectReason', 'churchId'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    // 초대 코드: 유효기간이 지난 코드는 조회 자체가 거부된다. 코드를 아는 사람만 get 할 수 있다.
    match /inviteCodes/{code} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      // 교역자·교회 운영자·앱 운영자는 그 교회의 코드 목록을 볼 수 있다 (churchId 조건으로만 조회).
      allow list: if signedIn() && isManager(resource.data.churchId);
      // 그 교회의 교역자만 코드를 만들 수 있다. 유효기간은 최대 31일.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['churchId', 'churchName', 'expiresAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
        && isManager(request.resource.data.churchId);
      allow update: if false;
      allow delete: if signedIn() && isManager(resource.data.churchId);
    }
    // 내 소속 교회 목록(collection group 쿼리): 본인 문서만 읽을 수 있다.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /churches/{churchId} {
      // 교회는 앱 운영자가 생성 요청을 승인할 때만 만들어진다. 교회 ID는 요청 ID와 같고,
      // 내용은 요청과 일치해야 하며, 요청한 사람이 만든 사람(첫 관리자)이 된다.
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(
             ['name', 'phone', 'address', 'createdBy', 'createdAt'])
        && (
          // 앱 운영자가 직접 등록: 전화번호는 비워둘 수 있다.
          (request.resource.data.createdBy == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
              && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
              && request.resource.data.address is string
              && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200)
          // 교회 생성 요청 승인: 요청과 같은 ID·내용으로만 만든다.
          || (churchRequest(churchId).status == 'pending'
              && request.resource.data.createdBy == churchRequest(churchId).requesterId
              && request.resource.data.name == churchRequest(churchId).name
              && request.resource.data.phone == churchRequest(churchId).phone
              && request.resource.data.address == churchRequest(churchId).address)
        );
      // 등록된 모든 교회 목록은 앱 운영자만 볼 수 있다.
      allow list: if isPlatformAdmin();
      allow get: if isManager(churchId);
      allow update, delete: if false;

      // ---- 교회별 교인 / 입장 신청 ----
      match /members/{memberId} {
        allow get: if signedIn() && (request.auth.uid == memberId || isManager(churchId));
        allow list: if isManager(churchId);

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(
               ['uid', 'churchId', 'churchName', 'name', 'email', 'phone', 'role', 'status',
                'createdAt', 'departmentIds', 'inviteCode'])
          && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 20)
          && request.resource.data.departmentIds == []
          && request.resource.data.uid == memberId
          && request.resource.data.churchId == churchId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && (
            // 본인이 유효기간 안의 초대 코드로 입장 신청: 항상 '교인 / 승인 대기'
            (request.auth.uid == memberId && emailVerified()
                && request.resource.data.role == 'member' && request.resource.data.status == 'pending'
                && request.resource.data.inviteCode is string
                && inviteOk(churchId, request.resource.data.inviteCode))

            // 앱 운영자가 교회 생성 요청을 승인할 때: 요청한 사람을 교회 운영자로 등록
            || (isPlatformAdmin()
                && request.resource.data.role == 'admin' && request.resource.data.status == 'approved'
                && churchRequest(churchId).status == 'pending'
                && churchRequest(churchId).requesterId == memberId)
          );

        allow update:
          // 관리자: 역할·상태 관리 (본인 계정은 제외해 잠금 방지)
          if (isOwner(churchId) && request.auth.uid != memberId
                && changed().hasOnly(['role', 'status']))
          // 교역자: 일반 교인의 승인 상태만 변경
          || (isManager(churchId) && resource.data.role == 'member'
                && changed().hasOnly(['status']))
          // 본인: 소속 부서 선택 (승인된 교인만)
          || (isActive(churchId) && request.auth.uid == memberId
                && changed().hasOnly(['departmentIds'])
                && request.resource.data.departmentIds is list
                && request.resource.data.departmentIds.size() <= 20);

        allow delete: if false;
      }

      // ---- 부서: 교역자가 만들고, 교인이 스스로 소속을 선택한다 ----
      match /departments/{deptId} {
        allow read: if isActive(churchId) || isPlatformAdmin();
        allow create: if isManager(churchId)
          && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;
        allow update: if isManager(churchId)
          && changed().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;
        allow delete: if false;
      }

      // ---- 기도제목 ----
      match /prayers/{prayerId} {
        // 일반 교인은 '공개 + 미삭제' 글과 본인의 미삭제 글만 읽을 수 있다.
        // 비공개 글은 쿼리 결과에도 포함되지 않는다.
        allow read: if isActive(churchId) && (
          isStaff(churchId)
          || (resource.data.visibility == 'public' && resource.data.deleted == false
              && inDept(churchId, resource.data.departmentId))
          || (resource.data.authorId == request.auth.uid && resource.data.deleted == false)
        );

        allow create: if isActive(churchId)
          && request.resource.data.keys().hasOnly(
               ['authorId', 'title', 'content', 'visibility', 'createdAt', 'updatedAt', 'deleted',
                'departmentId'])
          // 교회 전체(null)이거나 내가 소속된 부서에만 쓸 수 있다.
          && (request.resource.data.departmentId == null
              || isStaff(churchId)
              || request.resource.data.departmentId in get(memberPath(churchId)).data.departmentIds)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.visibility in ['public', 'private']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 3000;

        allow update: if isActive(churchId) && (
          // 작성자: 내용 수정 / 답변 확인 표시
          (resource.data.authorId == request.auth.uid && resource.data.deleted == false
            && changed().hasOnly(['title', 'content', 'visibility', 'updatedAt', 'responseSeenAt'])
            && request.resource.data.visibility in ['public', 'private']
            && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 3000)
          // 작성자: 본인 글 삭제 (소프트 삭제)
          || (resource.data.authorId == request.auth.uid && resource.data.deleted == false
            && changed().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
            && request.resource.data.deleted == true
            && request.resource.data.deletedBy == request.auth.uid)
          // 교역자: 삭제(사유 필수) / 복구 / 비공개 글 응답 시각 기록
          || (isStaff(churchId)
            && changed().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason', 'lastResponseAt'])
            && (request.resource.data.deleted == false
                || (request.resource.data.deletedBy == request.auth.uid
                    && request.resource.data.deleteReason is string
                    && request.resource.data.deleteReason.size() > 0)))
        );

        // 영구 삭제는 허용하지 않는다 (소프트 삭제만).
        allow delete: if false;

        // 이모티콘 응원: 문서 ID는 {uid}_{type}. 공개 글에만 가능하다.
        match /reactions/{reactionId} {
          allow read: if isActive(churchId) && (isStaff(churchId) || isOpen(churchId, prayerId));
          allow create: if isActive(churchId)
            && isOpen(churchId, prayerId)
            && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.type in ['pray', 'love', 'cheer', 'peace']
            && reactionId == request.auth.uid + '_' + request.resource.data.type;
          allow update: if false;
          allow delete: if isActive(churchId) && resource.data.uid == request.auth.uid;
        }

        // 교역자 댓글: 공개 글에만, 교역자·관리자만 작성.
        match /comments/{commentId} {
          allow read: if isActive(churchId) && (isStaff(churchId) || isOpen(churchId, prayerId));
          allow create: if isStaff(churchId)
            && isOpen(churchId, prayerId)
            && request.resource.data.keys().hasOnly(['authorId', 'content', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 500;
          allow update: if false;
          allow delete: if isStaff(churchId)
            && (resource.data.authorId == request.auth.uid || isAdmin(churchId));
        }

        // 비공개 글에 대한 교역자 응답: 작성자와 교역자만 읽을 수 있다.
        match /responses/{responseId} {
          allow read: if isStaff(churchId)
            || (isActive(churchId)
                && prayer(churchId, prayerId).authorId == request.auth.uid
                && prayer(churchId, prayerId).deleted == false);
          allow create: if isStaff(churchId)
            && prayer(churchId, prayerId).visibility == 'private'
            && request.resource.data.keys().hasOnly(['staffId', 'content', 'createdAt'])
            && request.resource.data.staffId == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000;
          allow update, delete: if false;
        }
      }

      // ---- 비공개 글 접근 기록: 교역자가 기록하고 관리자만 열람, 수정·삭제 불가 ----
      match /accessLogs/{logId} {
        allow create: if isStaff(churchId)
          && request.resource.data.keys().hasOnly(['staffId', 'prayerId', 'at'])
          && request.resource.data.staffId == request.auth.uid;
        allow read: if isAdmin(churchId);
        allow update, delete: if false;
      }
    }
  }
}

