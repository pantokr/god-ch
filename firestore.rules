rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function memberPath(cid) {
      return /databases/$(database)/documents/churches/$(cid)/members/$(request.auth.uid);
    }
    // 교회별로 승인된 교인만 해당 교회 데이터(기도제목 등)에 접근할 수 있다.
    // 앱 운영자는 교회 소속이 아니므로 기도제목 내용은 볼 수 없다 (아래 isManager/isOwner 참고).
    function isActive(cid) {
      return signedIn() && exists(memberPath(cid)) && get(memberPath(cid)).data.status == 'approved'
        && churchOpen(cid);
    }
    function isStaff(cid) {
      return isActive(cid) && get(memberPath(cid)).data.role in ['staff', 'admin'];
    }
    function isAdmin(cid) {
      return isActive(cid) && get(memberPath(cid)).data.role == 'admin';
    }
    // 교회 관리 데이터(교인·초대 코드·소속)를 다룰 수 있는 사람: 그 교회의 교역자·교회 운영자, 앱 운영자.
    function isManager(cid) {
      return isPlatformAdmin() || isStaff(cid);
    }
    // 교인의 역할을 바꿀 수 있는 사람: 그 교회의 교회 운영자, 앱 운영자.
    function isOwner(cid) {
      return isPlatformAdmin() || isAdmin(cid);
    }
    // 직급으로 줄 수 있는 권한 (lib/data/models/permission.dart의 Permission.delegable과 같다).
    // 교회가 정한 적이 없으면 교역자는 이 목록 전부를 갖는다.
    function delegable() {
      return ['member.manage', 'affiliation.edit',
              'prayer.post', 'prayer.engage', 'prayer.private',
              'devotion.post', 'devotion.engage', 'devotion.private',
              'meeting.manage', 'meeting.participants', 'meeting.join'];
    }
    // 교회가 정한 적이 없을 때 교역자가 갖는 권한 (lib/data/models/permission.dart의 Permission.staffDefault와 같다).
    // 소속 만들기 · 삭제는 기본으로 없고, 교회 관리자가 직급으로 줘야 한다.
    function staffDefaults() {
      return ['member.manage',
              'prayer.post', 'prayer.engage', 'prayer.private',
              'devotion.post', 'devotion.engage', 'devotion.private',
              'meeting.manage', 'meeting.participants', 'meeting.join'];
    }
    // 교회가 정한 적이 없을 때 회원이 갖는 권한 (지금까지 회원이 하던 일: Permission.memberDefault와 같다).
    function memberDefaults() {
      return ['prayer.post', 'prayer.engage',
              'devotion.engage', 'meeting.join'];
    }
    // 정한 적이 없을 때 교인이 "본인만" 범위로 갖는 권한 (Permission.memberOwnOnly와 같다): 본인이 쓴 글 · 댓글만 다룬다.
    function memberOwnOnly() {
      return ['prayer.post', 'prayer.engage', 'devotion.engage'];
    }
    // ---- 권한 판정 ----
    // 규칙 한 번에 쓸 수 있는 문서 읽기(get · exists)는 10번까지라, 판정 하나가 읽기를 적게 쓰도록 교인 문서와
    // 직급 문서를 한 번씩만 읽고 나머지는 계산으로 한다. (읽기를 많이 쓰면 뒤쪽 조건이 평가되지 못하고 거부된다.)
    // 정한 적이 없을 때 교역자 · 회원이 갖는 권한 (직급 문서가 없거나 permissions가 없을 때).
    function defaultHas(role, perm) {
      return role == 'staff' ? perm in staffDefaults() : (role == 'member' && perm in memberDefaults());
    }
    // 이 교인이 권한을 갖는가 (교인 문서 m, 그 역할의 직급 문서 p). 직급으로 받은 권한 또는 기본 직급의 권한이다.
    function memberHas(cid, m, perm) {
      let p = /databases/$(database)/documents/churches/$(cid)/positions/$(m.role);
      return m.status == 'approved' && churchOpen(cid)
        && (m.role == 'admin'
            || perm in m.get('permissions', [])
            || (exists(p) && get(p).data.get('permissions', null) is list
                ? perm in get(p).data.permissions
                : defaultHas(m.role, perm)));
    }
    // 권한이 있는가: 앱 운영자와 교회 총괄 관리자(그 교회의 절대 권한), 그 외에는 기본 직급(교역자 · 회원)과
    // 직급으로 받은 권한.
    function can(cid, perm) {
      return isPlatformAdmin() || memberHas(cid, get(memberPath(cid)).data, perm);
    }
    // ---- 권한 범위: 모든 직급에는 모든 권한이 있고, 권한마다 범위만 다르다 ----
    // 범위는 직급(교인 문서의 permissionScopes · 기본 직급 문서의 scopes)에 권한 키 → ['@mine']으로 있다.
    // 비어 있거나 없으면 전체(타인의 글 · 댓글 · 일정까지), '@mine'이 있으면 본인만(본인이 쓴 것 · 만든 것만)이다.
    // (lib/data/models/member.dart의 Member.scopeOf · canAll과 같다.)
    function memberAll(cid, m, perm) {
      let p = /databases/$(database)/documents/churches/$(cid)/positions/$(m.role);
      return m.status == 'approved' && churchOpen(cid)
        && (m.role == 'admin'
            || (perm in m.get('permissions', [])
                ? !('@mine' in m.get('permissionScopes', {}).get(perm, []))
                : (exists(p) && get(p).data.get('permissions', null) is list
                    ? perm in get(p).data.permissions
                        && !('@mine' in get(p).data.get('scopes', {}).get(perm, []))
                    // 정한 적이 없을 때: 교역자는 전체, 교인의 글 · 반응 · 댓글 관리는 본인만이다.
                    : (defaultHas(m.role, perm) && !(m.role == 'member' && perm in memberOwnOnly())))));
    }
    // 권한이 있고 범위가 전체인가: 타인의 것까지 다룰 수 있다. 앱 운영자와 교회 총괄 관리자는 늘 그렇다.
    function isAll(cid, perm) {
      return isPlatformAdmin() || memberAll(cid, get(memberPath(cid)).data, perm);
    }
    // 비공개 글을 볼 수 있는가: 비공개 글 조회 권한이 있고 범위가 전체다 (본인만이면 본인의 비공개 글만 본다).
    function viewsPrivate(cid, perm) {
      return isAll(cid, perm);
    }
    function prayer(cid, pid) {
      return get(/databases/$(database)/documents/churches/$(cid)/prayers/$(pid)).data;
    }
    // 소속 전용 글(affiliationId != null)은 그 소속에 속한 교인에게만 보인다.
    // 교역자 이상은 모든 글을 보고, 교인은 자기가 속한 소속의 글만 본다 (소속이 없는 미배정 교인은 아무 글도 못 본다).
    function inAff(cid, affId) {
      return isStaff(cid)
        || (affId != null && affId in get(memberPath(cid)).data.get('affiliationIds', []));
    }
    // 모임의 공개 범위는 소속 여럿(affiliationIds)이다. 비어 있으면 교회 전체다. 예전 일정은 소속 하나(affiliationId)만 있다.
    function meetingAffs(d) {
      return d.get('affiliationIds', d.get('affiliationId', null) == null ? [] : [d.get('affiliationId', null)]);
    }
    // 이 사람이 모임의 공개 범위 안인가: 전체이거나, 교역자 이상이거나, 범위의 소속 중 하나라도 내 소속이다.
    function inMeetingScope(cid, d) {
      return meetingAffs(d).size() == 0
        || meetingAffs(d).hasAny(get(memberPath(cid)).data.get('affiliationIds', []))
        || isStaff(cid);
    }
    // 말씀묵상 한 편을 이 사람이 볼 수 있는가: 공개이거나 비공개 조회 권한이 있고, 교역자 이상이거나 자기 소속의 글이다.
    function devotionOpen(cid, did) {
      let d = get(/databases/$(database)/documents/churches/$(cid)/devotions/$(did)).data;
      return (d.get('visibility', 'public') == 'public' || viewsPrivate(cid, 'devotion.private'))
        && inAff(cid, d.get('affiliationId', null));
    }
    function isOpen(cid, pid) {
      return prayer(cid, pid).visibility == 'public'
        && prayer(cid, pid).deleted == false
        && inAff(cid, prayer(cid, pid).get('affiliationId', null));
    }
    // 교회가 정한 기도 요청 운영 설정 (settings/prayer). 정한 적 없으면 기본값을 쓴다.
    function prayerOpt(cid, key, dflt) {
      let p = /databases/$(database)/documents/churches/$(cid)/settings/prayer;
      return exists(p) ? get(p).data.get(key, dflt) : dflt;
    }
    // 교회가 정한 말씀묵상 운영 설정 (settings/devotion). 정한 적 없으면 모두 허용 · 공개다.
    function devotionOpt(cid, key) {
      let p = /databases/$(database)/documents/churches/$(cid)/settings/devotion;
      return exists(p) ? get(p).data.get(key, true) : true;
    }
    // 교회가 정한 모임 일정 운영 설정 (settings/meeting). 정한 적 없으면 모두 허용 · 공개다.
    function meetingOpt(cid, key) {
      let p = /databases/$(database)/documents/churches/$(cid)/settings/meeting;
      return exists(p) ? get(p).data.get(key, true) : true;
    }
    // 공개 탐색에 노출된 교회인가 (입장 관리의 "노출"). 노출된 교회는 누구나 찾아서 입장을 요청할 수 있다.
    function churchListed(cid) {
      return get(/databases/$(database)/documents/churches/$(cid)).data.get('listed', false) == true;
    }
    // 폐기(revoked)되었거나 이미 쓰인(usedBy, 일회용) 코드는 무효다. 코드 문서는 지우지 않고 남긴다.
    function inviteOk(cid, code) {
      let invite = get(/databases/$(database)/documents/inviteCodes/$(code)).data;
      return invite.churchId == cid && invite.expiresAt > request.time
        && !invite.get('revoked', false) && invite.get('usedBy', '') == '';
    }
    // 차단 목록에 올라 있고(해제되지 않은) 계정인가. 해제해도 기록은 남는다.
    function isBlocked(cid, uid) {
      let path = /databases/$(database)/documents/churches/$(cid)/blocked/$(uid);
      return exists(path) && !get(path).data.get('revoked', false);
    }
    // 폐쇄된 교회는 교인이 더 이상 쓸 수 없다. 폐쇄해도 데이터는 지우지 않고 남긴다.
    function churchOpen(cid) {
      let path = /databases/$(database)/documents/churches/$(cid);
      return !exists(path) || !get(path).data.get('closed', false);
    }
    // 초대 코드에 담긴 역할·소속. 예전에 만든 코드에는 없으므로 교인·소속 없음으로 본다.
    function inviteRole(code) {
      return get(/databases/$(database)/documents/inviteCodes/$(code)).data.get('role', 'member');
    }
    function inviteAffiliations(code) {
      return get(/databases/$(database)/documents/inviteCodes/$(code)).data.get('affiliationIds', []);
    }
    // 주소·생년월일은 가입할 때 선택이고, 있으면 형식만 검사한다 (생년월일 YYYY-MM-DD).
    function extraValid(d) {
      return d.get('address', '') is string && d.get('address', '').size() <= 200
        && d.get('birthDate', '') is string && d.get('birthDate', '').size() <= 10
        && d.get('photoUrl', '') is string && d.get('photoUrl', '').size() <= 600;
    }
    // 교회가 입장 신청에 필수로 요청한 정보 (입장 관리의 "입장 시 필수 정보").
    function joinRequires(cid, field) {
      let p = /databases/$(database)/documents/churches/$(cid)/settings/join;
      return exists(p) && field in get(p).data.get('requiredFields', []);
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // 말씀묵상 글 한 건의 형식 검사.
    function contentValid(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.body is string && d.body.size() <= 5000
        && d.get('meditation', '') is string
        && d.get('meditation', '').size() >= 10 && d.get('meditation', '').size() <= 5000
        && d.date is timestamp
        // 첫 벌 말고 더해진 말씀 · 묵상은 최대 9벌이다 (한 글에 모두 10벌).
        && d.get('extras', []) is list && d.get('extras', []).size() <= 9;
    }
    // 목록(좋아요 · 참여자)에서 바뀐 사람이 나 하나뿐인가: 더하거나 빼는 것이 내 uid뿐이다.
    function onlyMeDiff(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid])
        && after.size() <= 1000;
    }
    // 조회수는 한 번에 하나씩만 오른다.
    function viewBump() {
      return request.resource.data.views == resource.data.get('views', 0) + 1;
    }
    // 앱 운영자: 계정에 platformAdmin 클레임이 있거나 admins/{uid} 문서가 있는 계정.
    // 둘 다 서버 관리자 권한으로만 만들 수 있다.
    function isPlatformAdmin() {
      return signedIn()
        && (request.auth.token.get('platformAdmin', false) == true
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // 교회 생성 요청 문서. 승인되면 같은 ID로 교회가 만들어진다.
    function churchRequest(requestId) {
      return get(/databases/$(database)/documents/churchRequests/$(requestId)).data;
    }

    // 글(기도제목 · 말씀묵상 · 모임)을 쓴 사람의 uid.
    function postAuthor(cid, kind, pid) {
      return kind == 'prayer' ? get(/databases/$(database)/documents/churches/$(cid)/prayers/$(pid)).data.authorId
        : (kind == 'devotion' ? get(/databases/$(database)/documents/churches/$(cid)/devotions/$(pid)).data.createdBy
        : get(/databases/$(database)/documents/churches/$(cid)/meetings/$(pid)).data.leaderId);
    }

    // 내 알림: 본인만 읽고 읽음 처리·삭제한다. 알림은 앱 운영자(교회 생성 요청 거절), 교회 운영자(추방), 모임 신청자(모임장에게)가 만든다.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if request.resource.data.keys().hasOnly(['type', 'title', 'body', 'read', 'createdAt', 'churchId', 'meetingId', 'postKind', 'postId'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.read == false
        && (
          (isPlatformAdmin() && request.resource.data.type in ['churchRejected', 'general'])
          // 교회 운영자: 그 교회에서 추방하는 교인에게 알린다 (추방과 같은 묶음 쓰기, 아직 교인일 때만).
          || (request.resource.data.type == 'churchRemoved'
              && request.resource.data.churchId is string
              && isOwner(request.resource.data.churchId)
              && request.auth.uid != userId
              && exists(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/members/$(userId))
              && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/members/$(userId)).data.status != 'removed')
          // 교인: 모임장 승인이 필요한 모임에 참여를 신청하면 모임장에게 알린다 (신청과 같은 묶음 쓰기).
          || (request.resource.data.type == 'meetingJoinRequest'
              && request.resource.data.churchId is string
              && request.resource.data.meetingId is string
              && request.auth.uid != userId
              && isActive(request.resource.data.churchId)
              && exists(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId))
              && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.leaderId == userId
              && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.get('needsApproval', false) == true
              // 같은 묶음 쓰기에서 내가 이 모임의 신청 대기에 들어간 경우만 (아무 때나 알림을 보낼 수 없다).
              && request.auth.uid in getAfter(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.get('pendingIds', []))
          // 모임장 · 승인 권한이 있는 사람: 참여 신청을 승인 · 거절하면 신청한 사람에게 알린다 (승인 · 거절과 같은 묶음 쓰기).
          || (request.resource.data.type in ['meetingApproved', 'meetingRejected']
              && request.resource.data.churchId is string
              && request.resource.data.meetingId is string
              && request.auth.uid != userId
              && isActive(request.resource.data.churchId)
              && (get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.leaderId == request.auth.uid
                  || isAll(request.resource.data.churchId, 'meeting.participants'))
              // 신청 대기 중이던 사람이, 같은 묶음 쓰기에서 대기에서 빠진 경우만 (승인이면 참여자가 되고, 거절이면 아무 쪽에도 없다).
              && userId in get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.get('pendingIds', [])
              && !(userId in getAfter(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.get('pendingIds', []))
              && (request.resource.data.type == 'meetingApproved')
                   == (userId in getAfter(/databases/$(database)/documents/churches/$(request.resource.data.churchId)/meetings/$(request.resource.data.meetingId)).data.get('participantIds', [])))
          // 교인: 글쓴이(기도제목 작성자 · 말씀묵상 작성자 · 모임장)에게 댓글 · 좋아요가 달렸음을 알린다 (댓글 · 좋아요와 같은 묶음 쓰기).
          || (request.resource.data.type in ['postComment', 'postLike']
              && request.resource.data.churchId is string
              && request.resource.data.postKind in ['prayer', 'devotion', 'meeting']
              && request.resource.data.postId is string
              && request.auth.uid != userId
              && isActive(request.resource.data.churchId)
              && postAuthor(request.resource.data.churchId, request.resource.data.postKind, request.resource.data.postId) == userId)
        );
      // 알림은 지우지 않는다: 읽음 처리, 또는 내 목록에서 숨김(hidden)만 한다.
      allow update: if signedIn() && request.auth.uid == userId
        && changed().hasOnly(['read', 'hidden'])
        && request.resource.data.get('read', false) is bool
        && request.resource.data.get('hidden', false) is bool;
      allow delete: if false;
    }

    // 로그인 ID → 이메일 조회. 로그인 전에 읽어야 하므로 get은 누구나 가능하고 목록은 볼 수 없다.
    // ID는 한 번 만들면 바꾸거나 지울 수 없고, 예약된 ID(admin 등)는 만들 수 없다.
    match /loginIds/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && loginId.matches('^[a-z][a-z0-9_]{3,19}$')
        && !(loginId in ['admin', 'administrator', 'root', 'system', 'operator'])
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      // 아이디는 지우지 않는다. 탈퇴해도 남아 다른 사람이 다시 쓰지 못한다.
      allow update, delete: if false;
    }

    // 회원 프로필: 가입할 때 받은 이름·전화번호와 개인정보 제3자 제공 동의 기록.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isPlatformAdmin());
      // 앱 운영자 패널의 회원 관리에서 전체 회원을 볼 수 있다.
      allow list: if isPlatformAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['loginId', 'email', 'name', 'phone', 'address', 'birthDate', 'photoUrl', 'consentThirdParty', 'consentAt', 'createdAt'])
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 100
        && extraValid(request.resource.data)
        && request.resource.data.consentThirdParty == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20;
      // 본인과 앱 운영자는 이름·전화번호만 고칠 수 있다.
      allow update: if signedIn()
        && (request.auth.uid == userId || isPlatformAdmin())
        && changed().hasOnly(['name', 'phone', 'address', 'birthDate', 'photoUrl'])
        && extraValid(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20;
      // 앱 탈퇴: 프로필은 지우지 않고 탈퇴 표시만 남긴다. 앱 운영자는 강제로 탈퇴시킬 수 있다.
      allow update: if signedIn() && (request.auth.uid == userId || isPlatformAdmin())
        && changed().hasOnly(['withdrawn', 'withdrawnAt'])
        && request.resource.data.withdrawn == true;
      allow delete: if false;
    }

    match /admins/{adminId} {
      // 자신이 운영자인지 확인할 수 있을 뿐, 클라이언트에서는 만들거나 바꿀 수 없다.
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // 교회 생성 요청: 누구나 신청하고, 앱 운영자가 승인/거절한다.
    match /churchRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['requesterId', 'requesterName', 'requesterPhone', 'name', 'phone',
              'address', 'status', 'createdAt'])
        && (!('requesterPhone' in request.resource.data) || request.resource.data.requesterPhone.size() <= 20)
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 30;
      // 요청자는 자기 요청만, 운영자는 모든 요청을 읽는다.
      allow get: if signedIn() && (resource.data.requesterId == request.auth.uid || isPlatformAdmin());
      allow list: if signedIn() && (resource.data.requesterId == request.auth.uid || isPlatformAdmin());
      allow update: if isPlatformAdmin()
        && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectReason', 'churchId'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    // 교회 폐쇄 요청: 그 교회의 운영자가 사유와 함께 요청하고, 앱 운영자가 승인/거절한다.
    // 요청도 승인도 아무것도 지우지 않는다 (승인하면 교회에 closed 표시만 남는다).
    match /churchClosureRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['churchId', 'churchName', 'requesterId', 'requesterName', 'reason', 'status', 'createdAt'])
        && request.resource.data.churchId is string
        && isAdmin(request.resource.data.churchId)
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.churchName is string && request.resource.data.churchName.size() <= 50
        && request.resource.data.requesterName is string && request.resource.data.requesterName.size() <= 30
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500;
      allow get: if signedIn() && (resource.data.requesterId == request.auth.uid || isPlatformAdmin()
        || isAdmin(resource.data.churchId));
      allow list: if signedIn() && (resource.data.requesterId == request.auth.uid || isPlatformAdmin()
        || isAdmin(resource.data.churchId));
      allow update: if isPlatformAdmin()
        && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectReason'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    // 초대 코드: 유효기간이 지난 코드는 조회 자체가 거부된다. 코드를 아는 사람만 get 할 수 있다.
    match /inviteCodes/{code} {
      allow get: if signedIn() && resource.data.expiresAt > request.time
        && !resource.data.get('revoked', false) && resource.data.get('usedBy', '') == '';
      // 교역자·교회 운영자·앱 운영자는 그 교회의 코드 목록을 볼 수 있다 (churchId 조건으로만 조회).
      allow list: if signedIn() && can(resource.data.churchId, 'member.manage');
      // 그 교회의 교역자만 코드를 만들 수 있다. 유효기간은 최대 31일.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['churchId', 'churchName', 'expiresAt', 'createdBy', 'role', 'affiliationIds', 'singleUse'])
        && request.resource.data.get('singleUse', false) is bool
        // 코드로 들어오는 사람의 역할: 교인, 또는 (교회 운영자만 만들 수 있는) 교역자.
        && request.resource.data.role in ['member', 'staff']
        && (request.resource.data.role == 'member' || isOwner(request.resource.data.churchId))
        && request.resource.data.affiliationIds is list
        && request.resource.data.affiliationIds.size() <= 20
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
        && can(request.resource.data.churchId, 'member.manage');
      // 교회 이름이 바뀌면 앱 운영자가 코드에 담긴 교회 이름만 맞춰 고친다.
      allow update: if isOwner(resource.data.churchId)
        && changed().hasOnly(['churchName'])
        && request.resource.data.churchName is string
        && request.resource.data.churchName.size() > 0 && request.resource.data.churchName.size() <= 50;
      // 코드는 지우지 않는다. 교역자·교회 운영자는 폐기 표시(revoked)를 하고,
      // 일회용 코드는 그 코드로 입장을 신청하는 사람의 신청과 같은 묶음에서 '사용됨'(usedBy)이 된다.
      allow update: if signedIn() && !resource.data.get('revoked', false)
        && (
          (can(resource.data.churchId, 'member.manage')
            && changed().hasOnly(['revoked', 'revokedAt', 'revokedBy'])
            && request.resource.data.revoked == true
            && request.resource.data.revokedBy == request.auth.uid)
          || (resource.data.get('singleUse', false) == true
            && resource.data.get('usedBy', '') == ''
            && changed().hasOnly(['usedBy', 'usedAt'])
            && request.resource.data.usedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/churches/$(resource.data.churchId)/members/$(request.auth.uid))
                 .data.get('inviteCode', '') == code)
        );
      allow delete: if false;
    }
    // 내 소속 교회 목록(collection group 쿼리): 본인 문서만 읽을 수 있다.
    match /{path=**}/members/{memberId} {
      // 앱 운영자는 회원 이름·전화번호를 고칠 때 그 회원의 모든 교회 정보를 찾는다.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isPlatformAdmin());
    }

    // 내 활동의 "내 댓글": 일정 · 중보기도 댓글과 말씀묵상 댓글을 교회를 가로질러 모은다 (collection group 조회).
    // 본인이 쓴 댓글만 읽을 수 있다.
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn() && resource.data.get('authorId', '') == request.auth.uid;
    }
    match /{path=**}/reflections/{reflectionId} {
      allow read: if signedIn() && resource.data.get('authorId', '') == request.auth.uid;
    }

    // 앱 운영자가 회원 관리에서 회원의 소속 이름을 보여주기 위한 collection group 조회.
    match /{path=**}/affiliations/{affId} {
      allow read: if isPlatformAdmin();
    }

    match /churches/{churchId} {
      // 교회는 앱 운영자가 생성 요청을 승인할 때만 만들어진다. 교회 ID는 요청 ID와 같고,
      // 내용은 요청과 일치해야 하며, 요청한 사람이 만든 사람(첫 관리자)이 된다.
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(
             ['name', 'phone', 'address', 'createdBy', 'createdAt'])
        && (
          // 앱 운영자가 직접 등록: 전화번호는 비워둘 수 있다.
          (request.resource.data.createdBy == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
              && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
              && request.resource.data.address is string
              && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200)
          // 교회 생성 요청 승인: 요청과 같은 ID·내용으로만 만든다.
          || (churchRequest(churchId).status == 'pending'
              && request.resource.data.createdBy == churchRequest(churchId).requesterId
              && request.resource.data.name == churchRequest(churchId).name
              && request.resource.data.phone == churchRequest(churchId).phone
              && request.resource.data.address == churchRequest(churchId).address)
        );
      // 등록된 모든 교회 목록은 앱 운영자만 볼 수 있다.
      // 앱 운영자는 모든 교회를, 로그인한 누구나 공개 탐색에 노출된 교회를 볼 수 있다.
      allow list: if isPlatformAdmin() || (signedIn() && resource.data.listed == true);
      allow get: if isManager(churchId)
        || (signedIn() && resource.data.get('listed', false) == true)
        // 소속 교인(폐쇄된 뒤에도)은 교회 문서를 읽어 폐쇄 여부를 안다.
        || (signedIn() && exists(memberPath(churchId)));
      // 교회 관리자는 공개 탐색 노출 여부(listed)를 바꾼다.
      // 교회 정보(이름·전화번호·주소·썸네일)는 교회 운영자와 앱 운영자가 고친다.
      // 폐쇄(closed)는 앱 운영자가 폐쇄 요청을 승인할 때만 표시한다 (교회는 지우지 않는다).
      allow update: if (isOwner(churchId)
          && changed().hasOnly(['listed'])
          && request.resource.data.listed is bool)
        || (isPlatformAdmin()
          && changed().hasOnly(['closed', 'closedAt', 'closedBy'])
          && request.resource.data.closed is bool
          && request.resource.data.closedBy == request.auth.uid)
        || (isOwner(churchId)
        && changed().hasOnly(['name', 'phone', 'address', 'thumbnailUrl'])
        && request.resource.data.get('thumbnailUrl', '') is string
        && request.resource.data.get('thumbnailUrl', '').size() <= 600
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200);
      allow delete: if false;

      // ---- 차단 목록: 문서 ID가 차단된 계정. 본인은 자기 차단 여부를 확인할 수 있다 ----
      match /blocked/{blockedUid} {
        allow get: if signedIn() && (request.auth.uid == blockedUid || isManager(churchId));
        allow list: if isManager(churchId);
        allow create: if isOwner(churchId) && request.auth.uid != blockedUid
          && request.resource.data.keys().hasOnly(['loginId', 'name', 'createdAt'])
          && request.resource.data.loginId is string && request.resource.data.loginId.size() <= 20
          && request.resource.data.name is string && request.resource.data.name.size() <= 30;
        // 해제는 지우지 않고 revoked 표시를 남긴다. 다시 차단하면 새 내용으로 덮는다.
        allow update: if isOwner(churchId) && request.auth.uid != blockedUid
          && request.resource.data.keys().hasOnly(['loginId', 'name', 'createdAt', 'revoked', 'revokedAt', 'revokedBy'])
          && request.resource.data.loginId is string && request.resource.data.loginId.size() <= 20
          && request.resource.data.name is string && request.resource.data.name.size() <= 30;
        allow delete: if false;
      }

      // ---- 교회별 교인 / 입장 신청 ----
      match /members/{memberId} {
        allow get: if signedIn() && (request.auth.uid == memberId || isManager(churchId));
        allow list: if isManager(churchId);

        // 입장 신청(또는 추방된 뒤 다시 신청)이 올바른가. d는 저장하려는 교인 문서.
        function joinOk(d) {
          return signedIn()
          // 차단된 계정은 이 교회에 들어올 수 없다.
          && !isBlocked(churchId, memberId)
          && churchOpen(churchId)
          && d.keys().hasOnly(
               ['uid', 'churchId', 'churchName', 'name', 'phone', 'loginId', 'email', 'address', 'birthDate', 'photoUrl',
                'role', 'status', 'createdAt', 'affiliationIds', 'inviteCode'])
          && d.get('email', '') is string
          && d.get('email', '').size() <= 100
          && extraValid(d)
          && d.get('loginId', '') is string
          && d.get('loginId', '').size() <= 20
          && (!('phone' in d) || d.phone.size() <= 20)
          && d.uid == memberId
          && d.churchId == churchId
          && d.name is string
          && d.name.size() > 0 && d.name.size() <= 30
          && (
            // 본인이 유효기간 안의 초대 코드로 입장 신청: 코드에 담긴 역할·소속으로, 항상 '승인 대기'
            // 앱 운영자는 교회 회원이 될 수 없다.
            (request.auth.uid == memberId && !isPlatformAdmin()
                && d.status == 'pending'
                && d.inviteCode is string
                && inviteOk(churchId, d.inviteCode)
                // 교회가 필수로 요청한 정보는 비워 둘 수 없다.
                && (!joinRequires(churchId, 'address')
                    || d.get('address', '').size() > 0)
                && (!joinRequires(churchId, 'birthDate')
                    || d.get('birthDate', '').size() > 0)
                && d.role == inviteRole(d.inviteCode)
                && d.affiliationIds == inviteAffiliations(d.inviteCode))

            // 공개 탐색에 노출된 교회에는 초대 코드 없이 입장을 요청할 수 있다: 항상 교인 역할, 소속 없이, '승인 대기'
            || (request.auth.uid == memberId && !isPlatformAdmin()
                && !('inviteCode' in d)
                && d.status == 'pending'
                && d.role == 'member'
                && d.affiliationIds == []
                && churchListed(churchId)
                && (!joinRequires(churchId, 'address')
                    || d.get('address', '').size() > 0)
                && (!joinRequires(churchId, 'birthDate')
                    || d.get('birthDate', '').size() > 0))

            // 앱 운영자가 교회 생성 요청을 승인할 때: 요청한 사람을 교회 운영자로 등록
            || (isPlatformAdmin()
                && d.role == 'admin' && d.status == 'approved'
                && d.affiliationIds == []
                && churchRequest(churchId).status == 'pending'
                && churchRequest(churchId).requesterId == memberId)
          );
        }

        allow create: if joinOk(request.resource.data);

        allow update:
          // 교회 운영자·앱 운영자: 교인을 내보낸다. 문서는 지우지 않고 status를 removed로 남긴다 (기록 보관).
          if (isOwner(churchId) && request.auth.uid != memberId
                && resource.data.status != 'removed'
                && changed().hasOnly(['status', 'removedAt', 'removedBy'])
                && request.resource.data.status == 'removed'
                && request.resource.data.removedBy == request.auth.uid)
          // 본인 탈퇴: 교회 관리자는 빠질 수 없다. 문서는 남기고 removed 표시만 한다.
          || (request.auth.uid == memberId
                && resource.data.status != 'removed'
                && resource.data.role != 'admin'
                && changed().hasOnly(['status', 'removedAt', 'removedBy'])
                && request.resource.data.status == 'removed'
                && request.resource.data.removedBy == request.auth.uid)
          // 추방된 사람이 초대 코드로 다시 신청 (차단된 계정은 joinOk가 막는다)
          || (resource.data.status == 'removed' && request.auth.uid == memberId
                && joinOk(request.resource.data))
          // 관리자: 역할·상태 관리 (본인 계정은 제외해 잠금 방지). 이미 승인된 사람의 상태는 바꾸지 못한다 (역할만).
          || (isOwner(churchId) && request.auth.uid != memberId
                && resource.data.status != 'removed'
                && changed().hasOnly(['role', 'status', 'approvedAt'])
                && (resource.data.status != 'approved' || request.resource.data.status == 'approved'))
          // 교역자: 일반 교인의 승인 상태만 변경 (이미 승인된 사람은 제외)
          || (can(churchId, 'member.manage') && resource.data.role == 'member'
                && resource.data.status != 'approved'
                && changed().hasOnly(['status', 'approvedAt']))
          // 본인: 이름·전화번호 수정 (users/{uid}와 같은 값으로 맞춘다)
          || (request.auth.uid == memberId
                && changed().hasOnly(['name', 'phone', 'address', 'birthDate', 'photoUrl'])
                && extraValid(request.resource.data)
                && request.resource.data.name is string
                && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
                && request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20)
          // 앱 운영자: 교회 이름이 바뀌면 교인 정보에 담긴 교회 이름만 맞춰 고친다.
          || (isOwner(churchId) && changed().hasOnly(['churchName'])
                && request.resource.data.churchName is string
                && request.resource.data.churchName.size() > 0
                && request.resource.data.churchName.size() <= 50)
          // 앱 운영자만: 교인의 이름·전화번호 등 개인정보 수정. 교회 운영자는 교회 회원 관리에서 볼 수만 있다 (본인은 내 정보에서).
          || (isPlatformAdmin() && request.auth.uid != memberId
                && changed().hasOnly(['name', 'phone', 'address', 'birthDate', 'photoUrl'])
                && extraValid(request.resource.data)
                && request.resource.data.name is string
                && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
                && request.resource.data.get('phone', '') is string
                && request.resource.data.get('phone', '').size() <= 20
                && request.resource.data.get('affiliationIds', []) is list
                && request.resource.data.get('affiliationIds', []).size() <= 20)
          // 교역자·교회 운영자: 교인을 소속에 넣고 빼기 (교인은 스스로 소속을 고를 수 없다)
          || (can(churchId, 'member.manage')
                && changed().hasOnly(['affiliationIds'])
                && request.resource.data.affiliationIds is list
                && request.resource.data.affiliationIds.size() <= 20);

        // 교회 운영자: 교인에게 직급을 주거나 뺀다. 권한은 직급에서 복사해 두며, 줄 수 있는 권한만 담을 수 있다.
        // (직급을 고치거나 지울 때도 그 직급의 교인 문서를 같은 방식으로 맞춘다.)
        allow update: if isOwner(churchId) && request.auth.uid != memberId
          && resource.data.status != 'removed'
          && changed().hasOnly(['positionId', 'permissions', 'permissionScopes'])
          && (request.resource.data.positionId == null
              || (request.resource.data.positionId is string && request.resource.data.positionId.size() <= 40))
          && request.resource.data.permissions is list
          && request.resource.data.permissions.size() <= 30
          && request.resource.data.permissions.hasOnly(delegable());

        // 교인 문서는 지우지 않는다 (추방은 위 update의 removed 표시).
        allow delete: if false;
      }

      // ---- 입장 시 필수 정보: 입장을 신청하는 사람도 읽어야 하므로 로그인한 누구나 읽고, 교회 관리자가 정한다 ----
      match /settings/join {
        allow get: if signedIn();
        allow create, update: if isOwner(churchId)
          && request.resource.data.keys().hasOnly(['requiredFields'])
          && request.resource.data.requiredFields is list
          && request.resource.data.requiredFields.size() <= 2
          && request.resource.data.requiredFields.hasOnly(['address', 'birthDate']);
      }

      // ---- 기도 요청 운영 설정: 교인이 읽고 교역자 · 교회 운영자가 정한다 ----
      match /settings/prayer {
        allow get: if isActive(churchId) || isPlatformAdmin();
        allow create, update: if isOwner(churchId)
          && request.resource.data.keys().hasOnly(['allowPrivate', 'reactions',
               'showCounts', 'requireDeleteReason', 'privateResponses', 'logPrivateAccess',
               'allowComments', 'showViews', 'showAuthor'])
          && request.resource.data.allowPrivate is bool
          && request.resource.data.reactions is list
          && request.resource.data.reactions.hasOnly(['pray', 'love', 'cheer', 'peace'])
          && request.resource.data.showCounts is bool
          && request.resource.data.requireDeleteReason is bool
          && request.resource.data.privateResponses is bool
          && request.resource.data.logPrivateAccess is bool
          && request.resource.data.allowComments is bool
          && request.resource.data.showViews is bool
          && request.resource.data.showAuthor is bool;
      }

      // ---- 말씀묵상 운영 설정: 교인이 읽고 교회 운영자가 정한다 ----
      match /settings/devotion {
        allow get: if isActive(churchId) || isPlatformAdmin();
        allow create, update: if isOwner(churchId)
          && request.resource.data.keys().hasOnly(['allowLikes', 'allowReflections', 'reflectionsPublic',
               'showViews', 'showAuthor', 'showLikeCount'])
          && request.resource.data.allowLikes is bool
          && request.resource.data.allowReflections is bool
          && request.resource.data.reflectionsPublic is bool
          && request.resource.data.showViews is bool
          && request.resource.data.showAuthor is bool
          && request.resource.data.showLikeCount is bool;
      }

      // ---- 모임 일정 운영 설정: 교인이 읽고 교회 운영자가 정한다 ----
      match /settings/meeting {
        allow get: if isActive(churchId) || isPlatformAdmin();
        allow create, update: if isOwner(churchId)
          && request.resource.data.keys().hasOnly(['allowLikes', 'allowComments', 'commentsPublic', 'showLikeCount', 'showViews'])
          && request.resource.data.allowLikes is bool
          && request.resource.data.allowComments is bool
          && request.resource.data.commentsPublic is bool
          && request.resource.data.showLikeCount is bool
          && request.resource.data.showViews is bool;
      }

      // ---- 사람 목록: 승인된 교인이 모두 읽는다. 이름 · 사진 · 역할 · 소속 · 생일(월-일)만 담은 교인 문서의 복사본이다 ----
      // 교인 문서가 바뀔 때 앱이 맞춰 쓴다. 교역자 · 인원 관리 권한이 있는 사람은 누구의 것이든 쓰고,
      // 본인은 자기 교인 문서와 역할 · 소속 · 상태가 같은 내용만 쓴다 (교회를 나갈 때는 승인 아님으로 쓸 수 있다).
      match /people/{personId} {
        allow read: if isActive(churchId) || isPlatformAdmin();
        allow create, update: if request.resource.data.keys().hasOnly(
               ['uid', 'name', 'photoUrl', 'role', 'status', 'affiliationIds', 'birthMonthDay', 'positionName', 'updatedAt'])
          && request.resource.data.uid == personId
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 800
          && request.resource.data.role in ['member', 'staff', 'admin']
          && request.resource.data.status in ['pending', 'approved', 'disabled', 'removed']
          && request.resource.data.affiliationIds is list && request.resource.data.affiliationIds.size() <= 20
          && request.resource.data.birthMonthDay is string && request.resource.data.birthMonthDay.size() <= 5
          && request.resource.data.get('positionName', '') is string && request.resource.data.get('positionName', '').size() <= 40
          && (isManager(churchId)
              || can(churchId, 'member.manage') || can(churchId, 'member.role')
              || (request.auth.uid == personId
                  // 그 교회의 교인(교인 문서가 있는 사람)만 자기 카드를 쓴다.
                  && exists(memberPath(churchId))
                  && (request.resource.data.status != 'approved'
                      || (isActive(churchId)
                          && request.resource.data.status == get(memberPath(churchId)).data.status
                          && request.resource.data.role == get(memberPath(churchId)).data.role
                          && request.resource.data.affiliationIds == get(memberPath(churchId)).data.get('affiliationIds', [])))));
        allow delete: if false;
      }

      // ---- 직급: 교회 운영자가 만들고 고치고(지움 표시) 권한을 정한다. 교인에게 줄 때는 members 규칙이 따로 있다 ----
      match /positions/{positionId} {
        // 기본 직급(교역자 · 회원)의 권한은 모든 교인이 읽어 자기 권한을 알 수 있다.
        allow read: if isManager(churchId)
          || (isActive(churchId) && positionId in ['staff', 'member']);
        // 기본 직급(교역자 · 회원) 문서: 이름 · 모양 · 권한을 고칠 수 있고, 지우면 기본값(이름 · 모양 · 권한)으로 돌아간다.
        allow create, update: if isOwner(churchId)
          && positionId in ['staff', 'member']
          && request.resource.data.keys().hasOnly(['name', 'permissions', 'scopes', 'icon', 'color', 'builtIn', 'updatedAt'])
          && request.resource.data.get('scopes', {}) is map
          && request.resource.data.get('icon', 'shield') is string && request.resource.data.get('icon', 'shield').size() <= 20
          && request.resource.data.get('color', 0) is int
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.builtIn == true
          && request.resource.data.permissions is list
          && request.resource.data.permissions.size() <= 30
          && request.resource.data.permissions.hasOnly(delegable());
        allow create: if isOwner(churchId)
          && !(positionId in ['staff', 'member', 'admin'])
          && request.resource.data.keys().hasOnly(['name', 'icon', 'color', 'permissions', 'scopes', 'deleted', 'createdBy', 'createdAt'])
          && request.resource.data.get('scopes', {}) is map
          && request.resource.data.get('icon', 'shield') is string && request.resource.data.get('icon', 'shield').size() <= 20
          && request.resource.data.get('color', 0) is int
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.permissions is list
          && request.resource.data.permissions.size() <= 30
          && request.resource.data.permissions.hasOnly(delegable());
        allow update: if isOwner(churchId)
          && !(positionId in ['staff', 'member', 'admin'])
          && changed().hasOnly(['name', 'icon', 'color', 'permissions', 'scopes', 'updatedAt', 'deleted', 'deletedAt', 'deletedBy'])
          && request.resource.data.get('scopes', {}) is map
          && request.resource.data.get('icon', 'shield') is string && request.resource.data.get('icon', 'shield').size() <= 20
          && request.resource.data.get('color', 0) is int
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.permissions is list
          && request.resource.data.permissions.size() <= 30
          && request.resource.data.permissions.hasOnly(delegable());
        // 기본 직급 문서는 지울 수 있다 (기본값으로 돌아간다). 직접 만든 직급은 지운 표시만 남긴다.
        allow delete: if isOwner(churchId) && positionId in ['staff', 'member'];
      }

      // ---- 소속: 교회 운영자가 만들고, 교역자가 교인을 넣는다. 교인은 스스로 고를 수 없다 ----
      match /affiliations/{affId} {
        allow read: if isActive(churchId) || isPlatformAdmin();
        // 만들기: 교회 관리자이거나 소속 생성 권한이 있는 사람.
        allow create: if (isOwner(churchId) || can(churchId, 'affiliation.edit'))
          && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;
        // 이름 변경은 교회 관리자, 삭제(지운 표시만 남긴다)는 소속 삭제 권한이 있는 사람이다.
        allow update: if (isOwner(churchId)
              && changed().hasOnly(['name'])
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30)
          || (can(churchId, 'affiliation.edit')
              && resource.data.get('deleted', false) == false
              && changed().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
              && request.resource.data.deleted == true
              && request.resource.data.deletedBy == request.auth.uid);
        allow delete: if false;
      }

      // ---- 기도제목 ----
      match /prayers/{prayerId} {
        // 일반 교인은 '공개 + 미삭제' 글과 본인의 미삭제 글만 읽을 수 있다.
        // 비공개 글은 쿼리 결과에도 포함되지 않는다.
        allow read: if isActive(churchId) && (
          viewsPrivate(churchId, 'prayer.private')
          || ((resource.data.visibility == 'public' && resource.data.deleted == false
                && inAff(churchId, resource.data.get('affiliationId', null)))
              || (resource.data.authorId == request.auth.uid && resource.data.deleted == false))
        );

        allow create: if isActive(churchId)
          && can(churchId, 'prayer.post')
          && (request.resource.data.visibility == 'public' || prayerOpt(churchId, 'allowPrivate', true))
          && request.resource.data.keys().hasOnly(
               ['authorId', 'authorName', 'content', 'visibility', 'createdAt', 'updatedAt', 'deleted',
                'affiliationId', 'views'])
          // 조회수는 0에서 시작한다.
          && request.resource.data.get('views', 0) == 0
          // 교회 전체(null)이거나 내가 속한 소속에만 쓸 수 있다.
          && (isStaff(churchId)
              || (request.resource.data.affiliationId != null
                  && request.resource.data.affiliationId in get(memberPath(churchId)).data.get('affiliationIds', [])))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.visibility in ['public', 'private']
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000;

        allow update: if isActive(churchId) && (
          // 작성자: 내용 수정 / 답변 확인 표시
          (resource.data.authorId == request.auth.uid && resource.data.deleted == false
            && changed().hasOnly(['content', 'visibility', 'updatedAt', 'responseSeenAt'])
            && request.resource.data.visibility in ['public', 'private']
            && (request.resource.data.visibility == 'public' || prayerOpt(churchId, 'allowPrivate', true))
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000)
          // 교역자: 공개 글의 제목·내용 수정 (비공개 글은 고칠 수 없다). 고친 사람과 시각이 남는다.
          || (isStaff(churchId)
            && resource.data.visibility == 'public' && resource.data.deleted == false
            && changed().hasOnly(['content', 'updatedAt', 'moderatedBy', 'moderatedAt'])
            && request.resource.data.moderatedBy == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000)
          // 교인: 읽을 수 있는 글의 조회수 +1, 읽음 표시
          || (resource.data.deleted == false
            && ((changed().hasOnly(['views']) && viewBump())
                // 읽음 표시: 내 uid만 더한다.
                || (changed().hasOnly(['readBy'])
                    && request.resource.data.readBy.toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid])
                    && request.resource.data.readBy.size() <= 1000))
            && (viewsPrivate(churchId, 'prayer.private') || resource.data.authorId == request.auth.uid
                || (resource.data.visibility == 'public'
                    && inAff(churchId, resource.data.get('affiliationId', null)))))
          // 작성자: 본인 글 삭제 (소프트 삭제). 설정 없이 누구나 한다.
          || (resource.data.authorId == request.auth.uid && resource.data.deleted == false
            && changed().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
            && request.resource.data.deleted == true
            && request.resource.data.deletedBy == request.auth.uid)
          // 교역자: 삭제(사유 필수) / 복구 / 비공개 글 응답 시각 기록
          || (isAll(churchId, 'prayer.post')
            // 직급으로 이 권한을 받은 교인도 자기가 볼 수 있는 글(자기 소속의 공개 글)만 지울 수 있다.
            && (isStaff(churchId) || isAll(churchId, 'prayer.post')
                || (resource.data.visibility == 'public'
                    && inAff(churchId, resource.data.get('affiliationId', null))))
            && changed().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason', 'lastResponseAt'])
            && (request.resource.data.deleted == false
                || (request.resource.data.deletedBy == request.auth.uid
                    && (!prayerOpt(churchId, 'requireDeleteReason', true)
                        || (request.resource.data.deleteReason is string
                            && request.resource.data.deleteReason.size() > 0)))))
        );

        // 영구 삭제는 허용하지 않는다 (소프트 삭제만).
        allow delete: if false;

        // 이모티콘 응원: 문서 ID는 {uid}_{type}. 공개 글에만 가능하다.
        match /reactions/{reactionId} {
          allow read: if isActive(churchId) && (viewsPrivate(churchId, 'prayer.private') || isOpen(churchId, prayerId));
          allow create: if isActive(churchId)
            && can(churchId, 'prayer.engage')
            && isOpen(churchId, prayerId)
            && request.resource.data.keys().hasOnly(['uid', 'type', 'active', 'createdAt'])
            && request.resource.data.get('active', true) == true
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.type in ['pray', 'love', 'cheer', 'peace']
            && request.resource.data.type in prayerOpt(churchId, 'reactions', ['pray', 'love', 'cheer', 'peace'])
            && reactionId == request.auth.uid + '_' + request.resource.data.type;
          // 취소는 지우지 않고 active 표시만 바꾼다.
          allow update: if isActive(churchId)
            && can(churchId, 'prayer.engage')
            && isOpen(churchId, prayerId)
            && resource.data.uid == request.auth.uid
            && changed().hasOnly(['active', 'updatedAt'])
            && request.resource.data.active is bool;
          allow delete: if false;
        }

        // 교역자 댓글: 공개 글에만, 교역자·관리자만 작성.
        match /comments/{commentId} {
          allow read: if isActive(churchId) && (viewsPrivate(churchId, 'prayer.private') || isOpen(churchId, prayerId));
          // 댓글은 댓글 작성 권한이 있는 사람이 쓴다 (교역자는 기본으로 있고, 교인은 직급으로 받아야 한다).
          allow create: if can(churchId, 'prayer.engage')
            && prayerOpt(churchId, 'allowComments', true)
            && isOpen(churchId, prayerId)
            && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'content', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 500;
          // 삭제는 지운 표시만 남긴다: 본인 댓글은 본인 삭제 권한, 타인 댓글은 타인 댓글 삭제 권한.
          allow update: if isActive(churchId)
            && resource.data.get('deleted', false) == false
            && (
              (changed().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
                && request.resource.data.deleted == true
                && request.resource.data.deletedBy == request.auth.uid
                // 본인 댓글은 누구나 지우고, 타인 댓글은 타인 댓글 삭제 권한이 있어야 한다.
                && (resource.data.authorId == request.auth.uid
                    || isAll(churchId, 'prayer.engage')))
              // 수정: 본인 댓글의 내용만 고친다 (댓글을 쓸 수 있을 때).
              || (resource.data.authorId == request.auth.uid
                  && can(churchId, 'prayer.engage')
                  && prayerOpt(churchId, 'allowComments', true)
                  && isOpen(churchId, prayerId)
                  && changed().hasOnly(['content', 'editedAt'])
                  && request.resource.data.content is string
                  && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 500)
            );
          allow delete: if false;
        }

        // 비공개 글에 대한 교역자 응답: 작성자와 교역자만 읽을 수 있다.
        match /responses/{responseId} {
          allow read: if viewsPrivate(churchId, 'prayer.private')
            || (isActive(churchId)
                && prayer(churchId, prayerId).authorId == request.auth.uid
                && prayer(churchId, prayerId).deleted == false);
          allow create: if isStaff(churchId)
            && prayerOpt(churchId, 'privateResponses', true)
            && prayer(churchId, prayerId).visibility == 'private'
            && request.resource.data.keys().hasOnly(['staffId', 'content', 'createdAt'])
            && request.resource.data.staffId == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000;
          allow update, delete: if false;
        }
      }

      // ---- 모임: 교인이 만들면 모임장이 되고, 다른 교인은 참여를 신청한다 ----
      // 정원은 규칙이 막는다 (참여자가 정원을 넘을 수 없다). 지우지 않고 deleted 표시만 남긴다.
      match /meetings/{meetingId} {
        allow read: if isActive(churchId) || isPlatformAdmin();
        // 모임은 교역자 이상이 만든다.
        allow create: if can(churchId, 'meeting.manage')
          && request.resource.data.keys().hasOnly(['title', 'description', 'place', 'date', 'capacity', 'imageUrl',
               'leaderId', 'leaderName', 'participantIds', 'pendingIds', 'fee', 'needsApproval', 'likedBy', 'views', 'deleted', 'createdAt',
               'affiliationId', 'affiliationIds'])
          && request.resource.data.leaderId == request.auth.uid
          // 공개 범위: 소속 여럿(비어 있으면 교회 전체). 교회 전체는 교역자 이상(또는 소속이 없는 교인)만, 소속 전용은 내가 속한 소속들에만 만든다.
          && request.resource.data.get('affiliationId', null) == null
          && request.resource.data.get('affiliationIds', []) is list
          && request.resource.data.get('affiliationIds', []).size() <= 20
          && (isStaff(churchId)
              || (request.resource.data.get('affiliationIds', []).size() > 0
                  && request.resource.data.affiliationIds.toSet()
                       .difference(get(memberPath(churchId)).data.get('affiliationIds', []).toSet()).size() == 0)
              || (request.resource.data.get('affiliationIds', []).size() == 0
                  && get(memberPath(churchId)).data.get('affiliationIds', []).size() == 0))
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 24
          && request.resource.data.get('imageUrl', '') is string && request.resource.data.get('imageUrl', '').size() <= 1000
          && request.resource.data.description is string && request.resource.data.description.size() <= 2000
          && request.resource.data.place is string && request.resource.data.place.size() <= 8
          && request.resource.data.date is timestamp
          && request.resource.data.capacity is int
          && request.resource.data.capacity >= 2 && request.resource.data.capacity <= 200
          && request.resource.data.leaderName is string && request.resource.data.leaderName.size() <= 40
          && request.resource.data.deleted == false
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() <= request.resource.data.capacity
          && request.resource.data.likedBy is list && request.resource.data.likedBy.size() <= 1000
          // 참여자 없음(만든 사람도 스스로 참여해야 한다) · 좋아요 0 · 조회수 0으로 시작한다.
          && request.resource.data.participantIds == []
          && request.resource.data.likedBy.size() == 0
          && request.resource.data.views == 0
          // 회비(원)와 입장 조건(모임장 승인), 승인 대기는 비어 있는 채로 시작한다.
          && request.resource.data.fee is int
          && request.resource.data.fee >= 0 && request.resource.data.fee <= 10000000
          && request.resource.data.needsApproval is bool
          && request.resource.data.pendingIds == [];
        allow update: if isActive(churchId) && resource.data.deleted == false && (
          // 모임장 · 교역자: 내용 수정 (정원은 이미 참여한 사람 수 이상) 또는 삭제 표시
          (changed().hasOnly(['title', 'description', 'place', 'date', 'capacity', 'imageUrl', 'fee', 'needsApproval', 'updatedAt',
                 'deleted', 'deletedAt', 'deletedBy', 'affiliationId', 'affiliationIds'])
            && (resource.data.leaderId == request.auth.uid || isAll(churchId, 'meeting.manage'))
            && request.resource.data.get('affiliationId', null) == null
            && request.resource.data.get('affiliationIds', []) is list
            && request.resource.data.get('affiliationIds', []).size() <= 20
            // 공개 범위를 바꿀 때: 교역자 이상이거나 내가 속한 소속들로만 바꾼다.
            && (meetingAffs(request.resource.data).toSet() == meetingAffs(resource.data).toSet()
                || isStaff(churchId)
                || (meetingAffs(request.resource.data).size() > 0
                    && meetingAffs(request.resource.data).toSet()
                         .difference(get(memberPath(churchId)).data.get('affiliationIds', []).toSet()).size() == 0))
            && request.resource.data.get('fee', 0) is int
            && request.resource.data.get('fee', 0) >= 0 && request.resource.data.get('fee', 0) <= 10000000
            && request.resource.data.get('needsApproval', false) is bool
            && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 24
            && request.resource.data.get('imageUrl', '').size() <= 1000
            && request.resource.data.description.size() <= 2000
            && request.resource.data.place.size() <= 8
            && request.resource.data.capacity >= 2 && request.resource.data.capacity <= 200
            && request.resource.data.capacity >= resource.data.participantIds.size()
            && (request.resource.data.get('deleted', false) == false
                || request.resource.data.get('deletedBy', '') == request.auth.uid))
          // 교인: 참여 신청 · 취소 (정원 안에서)
          // (종료된 모임은 참여도 취소도 할 수 없다.)
          || (changed().hasOnly(['participantIds'])
              && resource.data.date > request.time
              && can(churchId, 'meeting.join')
              // 공개 범위 밖의 교인은 참여할 수 없다 (빠지는 것은 언제나 된다).
              && (inMeetingScope(churchId, resource.data)
                  || request.resource.data.participantIds.size() < resource.data.participantIds.size())
              && onlyMeDiff(resource.data.participantIds, request.resource.data.participantIds)
              && request.resource.data.participantIds.size() <= resource.data.capacity
              // 모임장 승인이 필요한 모임은 (모임장이 아닌 사람은) 스스로 참여자가 될 수 없고, 빠지기만 한다.
              && (!resource.data.get('needsApproval', false)
                  || resource.data.leaderId == request.auth.uid
                  || request.resource.data.participantIds.size() <= resource.data.participantIds.size()))
          // 교인: 모임장 승인이 필요한 모임에 참여 신청(승인 대기) · 신청 취소
          || (changed().hasOnly(['pendingIds'])
              && resource.data.date > request.time
              && resource.data.get('needsApproval', false)
              && can(churchId, 'meeting.join')
              && (inMeetingScope(churchId, resource.data)
                  || request.resource.data.pendingIds.size() < resource.data.get('pendingIds', []).size())
              && onlyMeDiff(resource.data.get('pendingIds', []), request.resource.data.pendingIds))
          // 모임장: 승인 대기 신청을 승인(참여자로 옮김, 정원 안에서) 또는 거절
          // (모임장 외에 일정 참여 승인 권한이 있는 사람 · 교회 관리자도 한다.)
          || (changed().hasOnly(['participantIds', 'pendingIds'])
              && resource.data.date > request.time
              && request.resource.data.participantIds.size() <= resource.data.capacity
              && request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet())
                   .hasOnly(resource.data.get('pendingIds', []))
              && resource.data.participantIds.toSet().difference(request.resource.data.participantIds.toSet()).size() == 0
              && request.resource.data.pendingIds.toSet().difference(resource.data.get('pendingIds', []).toSet()).size() == 0
              && (resource.data.leaderId == request.auth.uid || isAll(churchId, 'meeting.participants')))
          // 모임장 · 참여자 관리(승인 · 거절 · 추방) 권한이 있는 사람: 참여자(또는 대기자)를 내보낸다 (빼기만 가능)
          || (changed().hasOnly(['participantIds', 'pendingIds'])
              && resource.data.date > request.time
              && request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet()).size() == 0
              && request.resource.data.pendingIds.toSet().difference(resource.data.get('pendingIds', []).toSet()).size() == 0
              && (resource.data.leaderId == request.auth.uid || isAll(churchId, 'meeting.participants')))
          // 교인: 좋아요 · 조회수
          || (changed().hasOnly(['likedBy'])
              && meetingOpt(churchId, 'allowLikes')
              && onlyMeDiff(resource.data.get('likedBy', []), request.resource.data.likedBy))
          || (changed().hasOnly(['views']) && viewBump())
        );
        allow delete: if false;
      }

      // ---- 일정 댓글: 승인된 교인이 읽고 쓴다. 지우는 것은 본인과 일정 삭제 권한이 있는 사람 (지운 표시만 남긴다) ----
      match /meetings/{meetingId}/comments/{commentId} {
        // 댓글을 비공개로 두면 본인과 일정 삭제 권한이 있는 사람만 읽는다.
        allow read: if isPlatformAdmin()
          || (isActive(churchId)
              && (meetingOpt(churchId, 'commentsPublic')
                  || resource.data.authorId == request.auth.uid
                  || isAll(churchId, 'meeting.manage')));
        allow create: if isActive(churchId)
          && meetingOpt(churchId, 'allowComments')
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt', 'parentId'])
          && request.resource.data.authorId == request.auth.uid
          // 답글이면 같은 일정에 있는 댓글을 가리켜야 한다.
          && (!('parentId' in request.resource.data)
              || (request.resource.data.parentId is string
                  && exists(/databases/$(database)/documents/churches/$(churchId)/meetings/$(meetingId)/comments/$(request.resource.data.parentId))))
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow update: if isActive(churchId)
          && resource.data.get('deleted', false) == false
          && (
            // 지우기(지운 표시만 남긴다)
            (changed().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
              && request.resource.data.deleted == true
              && request.resource.data.deletedBy == request.auth.uid
              && (resource.data.authorId == request.auth.uid
                  || isAll(churchId, 'meeting.manage')))
            // 수정: 본인 댓글의 내용만 고친다.
            || (resource.data.authorId == request.auth.uid
                && meetingOpt(churchId, 'allowComments')
                && changed().hasOnly(['text', 'editedAt'])
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500)
          );
        allow delete: if false;
      }

      // ---- 말씀묵상(성경): 승인된 교인이 읽고, 교역자 · 교회 관리자(와 앱 개발자)가 글을 게시한다 ----
      match /devotions/{contentId} {
        // 비공개 글은 말씀묵상 비공개 조회 권한이 있는 사람만 읽는다. 공개 글만 묻는 조회(visibility == 'public')는 누구나 된다.
        // 교인은 자기가 속한 소속의 글만 읽는다 (조회는 소속마다 따로 묻는다).
        allow read: if isPlatformAdmin()
          || (isActive(churchId)
              && (resource.data.visibility == 'public' || viewsPrivate(churchId, 'devotion.private'))
              && inAff(churchId, resource.data.get('affiliationId', null)));
        allow create: if can(churchId, 'devotion.post')
          && request.resource.data.keys().hasOnly(['title', 'body', 'meditation', 'extras', 'date', 'views', 'likedBy', 'createdBy',
               'authorName', 'authorPhotoUrl', 'affiliationId', 'visibility', 'createdAt'])
          && request.resource.data.visibility in ['public', 'private']
          // 글마다 소속이 하나 있어야 한다 ("전체"는 없다). 교인은 자기 소속에만 쓴다.
          && request.resource.data.get('affiliationId', null) is string
          && (isStaff(churchId)
              || request.resource.data.affiliationId in get(memberPath(churchId)).data.get('affiliationIds', []))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.get('authorName', '') is string
          && request.resource.data.get('authorName', '').size() <= 40
          && request.resource.data.get('authorPhotoUrl', '') is string
          && request.resource.data.get('authorPhotoUrl', '').size() <= 1000
          // 조회수 0 · 좋아요 0으로 시작한다.
          && request.resource.data.get('views', 0) == 0
          && request.resource.data.get('likedBy', []) == []
          && contentValid(request.resource.data);
        allow update: if (changed().hasOnly(['title', 'body', 'meditation', 'extras', 'date', 'affiliationId', 'visibility', 'updatedAt'])
            && request.resource.data.visibility in ['public', 'private']
            && request.resource.data.get('affiliationId', null) is string
            && contentValid(request.resource.data)
            && can(churchId, 'devotion.post')
            // 남이 쓴 글은 교역자 이상만 고친다 (직급으로 쓰기 권한을 받은 교인은 본인 글만).
            && (isManager(churchId) || resource.data.get('createdBy', '') == request.auth.uid)
            && inAff(churchId, resource.data.get('affiliationId', null))
            && (isStaff(churchId)
                || (request.resource.data.get('affiliationId', null) != null
                    && request.resource.data.affiliationId in get(memberPath(churchId)).data.get('affiliationIds', []))))
          // 글 삭제(지운 표시만 남긴다): 본인 글은 글을 쓸 수 있으면 누구나, 타인 글은 타인 글 삭제 권한이 있어야 한다.
          || (changed().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
            && resource.data.get('deleted', false) == false
            && request.resource.data.deleted == true
            && request.resource.data.deletedBy == request.auth.uid
            && (resource.data.get('createdBy', '') == request.auth.uid
                ? can(churchId, 'devotion.post')
                : isAll(churchId, 'devotion.post'))
            && inAff(churchId, resource.data.get('affiliationId', null)))
          // 교인: 조회수 +1, 좋아요 누르기 · 취소 (한 번에 하나만)
          || (resource.data.get('deleted', false) == false
            && ((changed().hasOnly(['views']) && viewBump())
                // 읽음 표시: 내 uid만 더한다.
                || (changed().hasOnly(['readBy'])
                    && request.resource.data.readBy.toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid])
                    && request.resource.data.readBy.size() <= 1000)
                || (changed().hasOnly(['likedBy'])
                    && devotionOpt(churchId, 'allowLikes')
                    && onlyMeDiff(resource.data.get('likedBy', []), request.resource.data.likedBy)
                    && can(churchId, 'devotion.engage')))
            // 볼 수 있는 글에만 조회수 · 읽음 · 좋아요를 남긴다 (공개이거나 비공개 조회 권한, 그리고 자기 소속).
            && inAff(churchId, resource.data.get('affiliationId', null))
            && (resource.data.visibility == 'public' || viewsPrivate(churchId, 'devotion.private'))
            && isActive(churchId));
        // 글은 지우지 않고 deleted 표시만 남긴다.
        allow delete: if false;
      }

      // ---- 말씀묵상에 교인이 남기는 자기 글: 한 사람이 한 편에 한 개 (문서 ID가 본인 uid) ----
      // 승인된 교인이 읽고 본인 글만 쓴다. 지우는 것은 본인과 교회의 교역자·운영자. 글 길이는 DevotionReflection.maxLength와 같다.
      match /devotions/{devotionId}/reflections/{reflectionId} {
        // 댓글을 비공개로 두면 본인(authorId)과 교역자만 읽는다. 비공개 글의 댓글은 비공개 조회 권한이 있어야 한다.
        allow read: if isPlatformAdmin()
          || (isActive(churchId)
              && (devotionOpt(churchId, 'reflectionsPublic') || isStaff(churchId)
                  || resource.data.get('authorId', '') == request.auth.uid)
              && devotionOpen(churchId, devotionId));
        // 댓글 달기: 한 사람이 여러 개를 달 수 있다 (문서 ID는 자동).
        allow create: if isActive(churchId)
          && can(churchId, 'devotion.engage')
          && devotionOpen(churchId, devotionId)
          && devotionOpt(churchId, 'allowReflections')
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'updatedAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        // 지우기(지운 표시만 남긴다): 본인 댓글은 댓글을 쓸 수 있으면 누구나, 타인 댓글은 타인 댓글 삭제 권한이 있어야 한다. 고치는 것은 본인 댓글의 내용(수정)뿐이다.
        allow update: if isActive(churchId)
          && resource.data.get('deleted', false) == false
          && (
            (changed().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
              && request.resource.data.deleted == true
              && request.resource.data.deletedBy == request.auth.uid
              && (resource.data.get('authorId', '') == request.auth.uid
                  ? can(churchId, 'devotion.engage')
                  : isAll(churchId, 'devotion.engage')))
            // 수정: 본인 댓글의 내용만 고친다 (댓글을 쓸 수 있을 때).
            || (resource.data.get('authorId', '') == request.auth.uid
                && can(churchId, 'devotion.engage')
                && devotionOpen(churchId, devotionId)
                && devotionOpt(churchId, 'allowReflections')
                && changed().hasOnly(['text', 'editedAt'])
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
          );
        allow delete: if false;
      }

      // ---- 비공개 글 접근 기록: 교역자가 기록하고 관리자만 열람, 수정·삭제 불가 ----
      match /accessLogs/{logId} {
        allow create: if isStaff(churchId)
          && request.resource.data.keys().hasOnly(['staffId', 'prayerId', 'at'])
          && request.resource.data.staffId == request.auth.uid;
        allow read: if isAdmin(churchId);
        allow update, delete: if false;
      }
    }
  }
}

