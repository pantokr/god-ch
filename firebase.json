{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "being-built-together",
          "appId": "1:803236883584:android:ff470e40c3f46356b18a65",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "being-built-together",
          "configurations": {
            "android": "1:803236883584:android:ff470e40c3f46356b18a65",
            "ios": "1:803236883584:ios:bb67220d61912f75b18a65",
            "web": "1:803236883584:web:aeafb2ccb2709ebdb18a65"
          }
        }
      }
    }
  }
}
