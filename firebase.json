{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "god-ch",
          "appId": "1:895180814475:android:3d2b40ae23bde61a34fc8e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "god-ch",
          "configurations": {
            "android": "1:895180814475:android:3d2b40ae23bde61a34fc8e",
            "ios": "1:895180814475:ios:6b4ae66c8fd3745834fc8e",
            "web": "1:895180814475:web:346a2ff429f64f4634fc8e"
          }
        }
      }
    }
  }
}
